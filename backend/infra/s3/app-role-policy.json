{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyTenantPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::sitevision-prod",
      "Condition": { "StringLike": { "s3:prefix": ["myhome/*", "kohinoor/*"] } }
    },
    {
      "Sid": "ReadWriteTenantObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::sitevision-prod/myhome/*", "arn:aws:s3:::sitevision-prod/kohinoor/*"]
    }
  ]
}
