# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# SiteVision MediaSDK stitch worker  (app.stitch_worker)
#
# Runs the Insta360 MediaSDK image stitcher as a service SEPARATE from the API
# server. The API posts a capture to POST /v1/stitch and gets the validated
# equirectangular JPEG back. Built to match the environment that passed the
# isolated AWS CPU-only test (docs/MEDIASDK_EC2_CPU_TEST.md):
#   Ubuntu 22.04 + the SDK package's own Depends + native libtiff5, CPU rendering (Mesa llvmpipe).
#
# The SDK itself is NOT in this image (licence, ~4.5 GB, never in Git). Install/extract the official
# MediaSDK-3.2.0-linux-amd64.deb on the host and mount /opt/MediaSDK-3.2.0-linux read-only:
#
#   dpkg-deb -x MediaSDK-3.2.0-linux-amd64.deb /srv/mediasdk        # -> /srv/mediasdk/opt/MediaSDK-3.2.0-linux
#   docker build -f Dockerfile.stitch-worker -t sitevision-stitch-worker .
#   docker run --rm -p 8010:8010 --cpus 2 --memory 4g --memory-swap 4g --pids-limit 128 \
#     --read-only --tmpfs /tmp:size=1g --cap-drop ALL --security-opt no-new-privileges \
#     -v /srv/mediasdk/opt/MediaSDK-3.2.0-linux:/opt/MediaSDK-3.2.0-linux:ro \
#     -e MEDIASDK_WORKER_TOKEN=change-me sitevision-stitch-worker
#
# GPU is NOT used and has not been verified (see docs/MEDIASDK_LINUX_MIGRATION.md).
# Python 3.12 (required by the app; 22.04 ships 3.10) comes from uv's standalone builds.
# ─────────────────────────────────────────────────────────────────────────────
ARG UV_VERSION=0.12.15
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

# CA bundle only (used when APT_USE_HTTPS=true; the Ubuntu base image ships none).
FROM python:3.12-slim-bookworm AS certs

FROM ubuntu:22.04
# Some corporate proxies block apt's plain-HTTP requests (403) but allow HTTPS to the same archive. Build with
# --build-arg APT_USE_HTTPS=true to fetch packages over HTTPS WITH certificate verification. Default: unchanged.
ARG APT_USE_HTTPS=false
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_LINK_MODE=copy
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /tmp/ca-bundle.crt
RUN if [ "$APT_USE_HTTPS" = "true" ]; then \
      mkdir -p /etc/ssl/certs && cp /tmp/ca-bundle.crt /etc/ssl/certs/ca-certificates.crt \
      && sed -i 's|http://|https://|g' /etc/apt/sources.list; \
    fi; rm -f /tmp/ca-bundle.crt

# The .deb's own "Depends:" list, plus Mesa software GL/Vulkan so it renders on CPU-only hosts.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libx11-6 libgomp1 libxcb1 libpng16-16 libgl1 libglx0 libglvnd0 libegl1 libjpeg-turbo8 libxdmcp6 \
      libbsd0 libxau6 libmd0 libxext6 libvulkan1 libglfw3 libdc1394-dev libopenblas0 libtiff5 libfreetype6 \
      libharfbuzz0b libgtk-3-0 libcairo2 libgdk-pixbuf-2.0-0 libglib2.0-0 \
      mesa-vulkan-drivers libgl1-mesa-dri \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY requirements-worker.txt .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv --python 3.12 /opt/venv \
    && uv pip install --python /opt/venv/bin/python -r requirements-worker.txt \
    && chmod -R a+rX /opt/python /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY app ./app

RUN useradd --system --uid 10001 --home /app stitch && chown -R stitch /app
USER stitch

# libtiff5 is native on 22.04, so no MEDIASDK_TIFF_LIB_DIR. CPU only, one stitch at a time per worker process.
# Thread pools default to one per visible CPU; cap them so the container stays far below its 128-process limit
# (a 32-core host needs ~135 uncapped and aborts). The adapter applies the same cap to the SDK (MEDIASDK_THREADS).
ENV OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 OPENCV_FOR_THREADS_NUM=2 LP_NUM_THREADS=2
ENV MEDIASDK_HOME=/opt/MediaSDK-3.2.0-linux \
    MEDIASDK_ENABLE_CUDA=false \
    MEDIASDK_IMAGE_ACCEL=cpu \
    MEDIASDK_MAX_CONCURRENCY=1

EXPOSE 8010
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8010/health', timeout=8).status == 200 else 1)"

CMD ["uvicorn", "app.stitch_worker:app", "--host", "0.0.0.0", "--port", "8010"]
