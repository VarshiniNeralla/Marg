# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="SiteVision"
APP_ENV=development
# development | staging | production
DEBUG=true
FRONTEND_URL=http://localhost:5173

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
DB_NAME=virtual_tour

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_use_openssl_rand_hex_64
JWT_REFRESH_SECRET=change_me_use_openssl_rand_hex_64_different
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cloudinary (floor plans always; capture fallback) ───────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_cloud_secret

# ── Media storage ─────────────────────────────────────────────────────────────
# Hybrid: floor plans → Cloudinary (sharp). Captures → local when MEDIA_STORAGE=local.
MEDIA_STORAGE=local
# Absolute path preferred on Windows, e.g. D:\...\virtual_room_tour\uploads
# Leave empty to use <repo>/uploads
UPLOAD_ROOT=
# Optional absolute API origin for local /media URLs (tablet/tunnel). Leave empty
# to store relative /media/... paths; the frontend prefixes VITE_API_BASE_URL.
MEDIA_PUBLIC_BASE_URL=
# Require JWT or HMAC signature for /media (default true). Set false only for
# local debugging of raw file URLs in a browser.
# MEDIA_REQUIRE_AUTH=true
# MEDIA_URL_TTL_SECONDS=604800
# Stitched 360 equirect (2:1). Defaults ≈ 8K @ JPEG 95. Higher = sharper zoom,
# slower stitch, larger files. Example prior default: 5760 / 2880 / 90.
# STITCH_OUTPUT_WIDTH=7680
# STITCH_OUTPUT_HEIGHT=3840
# STITCH_JPEG_QUALITY=95
# Rejected stitch JPEGs land under <UPLOAD_ROOT>/stitch_failures/ for diagnosis.
# Failed-job raw .insp files are retained under stitch-spool/ for Retry Stitch.
# ── Vision / LLM (construction progress analysis) ─────────────────────────────
# Supported providers: groq | vllm
# Leave blank to auto-select: groq in production, vllm locally.
VISION_PROVIDER=

# vLLM (local OpenAI-compatible server)
VLLM_BASE_URL=http://127.0.0.1:8000
VLLM_MODEL=gemma4-31b
VLLM_API_KEY=
VLLM_TEMPERATURE=0.3
VLLM_MAX_TOKENS=20000
VLLM_HTTP_TIMEOUT_S=300
# VLLM_MAX_RETRIES=2

# Groq (optional — still used for room-map extraction)
GROQ_API_KEY=your_groq_api_key
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_REQUEST_TIMEOUT_SECONDS=60
# GROQ_MAX_RETRIES=2

# ── Redis (refresh token revocation list + rate limiting) ─────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME="SiteVision"

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/15minutes
RATE_LIMIT_REGISTER=10/hour
RATE_LIMIT_FORGOT_PASSWORD=3/hour

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Cookies (refresh token) ───────────────────────────────────────────────────
# Leave blank for normal browser dev (defaults to "lax", no Secure/HTTPS needed).
# The packaged Android app (Capacitor) loads from its own app origin, which the
# browser treats as cross-site from this backend even in development — that
# cross-site cookie only survives with SameSite=None, which in turn REQUIRES
# Secure (HTTPS). To test the Android app against a local backend, run the
# backend behind HTTPS (e.g. a dev reverse proxy/tunnel) and set:
#   COOKIE_SAMESITE=none
# Un-set/leave blank again for plain browser-only development.
COOKIE_SAMESITE=

# ── Multi-tenancy (database per tenant) ─────────────────────────────────────
# Leave MULTI_TENANT_ENABLED=false until the cutover is approved. When true the
# tenant is resolved ONLY from the request Host (myhomeconstructions.com ->
# SiteVisionMyHome, kohinoorpune.com -> SiteVisionKohinoor); unknown hosts get 421.
# Provide the connection strings through the environment / a secret store, never in git.
MULTI_TENANT_ENABLED=false
TENANT_MYHOME_MONGO_URI=
TENANT_KOHINOOR_MONGO_URI=
# Exact extra hostnames (comma separated, no wildcards), e.g. a staging host.
TENANT_MYHOME_EXTRA_HOSTS=
TENANT_KOHINOOR_EXTRA_HOSTS=
# Set true only behind a reverse proxy that overwrites X-Forwarded-Host.
TENANT_TRUST_FORWARDED_HOST=false
# Non-production only: tenant for localhost/127.0.0.1 (myhome or kohinoor).
TENANT_DEV_DEFAULT=
TENANT_MYHOME_FRONTEND_URL=
TENANT_KOHINOOR_FRONTEND_URL=
# How the tenant is chosen when MULTI_TENANT_ENABLED=true: host (Host-header allowlist) or email (e-mail domain at sign-in, then the signed token).
TENANT_RESOLUTION=host
# Where NEW uploads go on a single-tenant deployment: legacy (SiteVision/...) or tenant (myhome/sites|users/...).
# Multi-tenant mode always uses the tenant layout. Switch to 'tenant' only after the files are copied and verified.
STORAGE_LAYOUT=legacy

# ── Object store (Amazon S3) behind /media ───────────────────────────────────
# disk = files under UPLOAD_ROOT (default). s3 = the bucket below; keys are the same relative paths as on disk
# (<tenant>/sites|users/<kind>/<org>/...), so URLs/public_ids stored in Mongo keep working without a rewrite.
# AWS credentials come from the standard chain (EC2 instance role in production): never put keys in this file.
MEDIA_OBJECT_STORE=disk
S3_BUCKET=
S3_REGION=ap-south-1
# While migrating: serve from UPLOAD_ROOT when an object is not in S3 yet (reads only).
S3_READ_FALLBACK_TO_DISK=true
# cloudinary (default) or object-store: store floor plans in the object store and render PDF page 1 locally.
# Switch only after the existing floor plans are migrated and verified.
FLOORPLAN_STORAGE=cloudinary

# How many raw 360 captures may be stitched at the same time (extra ones wait as "pending"). Each stitch is heavy:
# keep 1 on a 2 vCPU / 8 GiB server; raise only on a larger one.
STITCH_MAX_CONCURRENCY=1
