# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose settings (OPTIONAL).
#
# Copy to ".env" in this same folder (next to docker-compose.yml) only if you
# want to change a default. Application secrets do NOT go here — they live in
# backend/.env (see backend/.env.example).
# ─────────────────────────────────────────────────────────────────────────────

# Port on your PC where the website opens: http://localhost:8080
FRONTEND_PORT=8080

# Port on your PC for direct API access (Swagger at http://localhost:8002/docs)
BACKEND_PORT=8002

# Public URL of the website — used in password-reset emails
FRONTEND_PUBLIC_URL=http://localhost:8080

# Gemma / vLLM server (OpenAI-compatible). The backend calls
#   ${VLLM_BASE_URL}/v1/chat/completions
# - vLLM on THIS PC                → http://host.docker.internal:8000
# - vLLM on another PC / GPU server → http://<that-ip>:8000
# Current office setup: Gemma runs on another PC in the office LAN — put that
# PC's IPv4 address here (find it on that PC with `ipconfig`, Ethernet adapter).
VLLM_BASE_URL=http://<GEMMA_PC_IP>:8000

# Private subnet for the containers' internal network. Must NOT overlap your
# office LAN (172.20.0.0/16) or LAN hosts like the Gemma PC become unreachable.
DOCKER_SUBNET=192.168.213.0/24

# Refresh-cookie SameSite override. Leave blank for the browser UI.
# Set to "none" only when serving over HTTPS for the Android app.
COOKIE_SAMESITE=

# Frontend build-time values (rebuild the frontend image after changing).
# "/" = same origin as the website (recommended).
VITE_API_BASE_URL=/
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Tag for the built images (e.g. 1.0.0 when preparing a release)
IMAGE_TAG=latest
