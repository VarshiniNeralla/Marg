# My Home, LOCAL DEVELOPMENT against the multi-tenant backend (npm run dev:myhome, http://localhost:5181). No secrets here.
# Plain 'npm run dev' is unchanged and keeps using the existing single-tenant backend.
# The backend chooses SiteVisionMyHome from the e-mail domain @myhomeconstructions.com at sign-in.
VITE_API_BASE_URL=http://localhost:8010
VITE_TENANT=myhome
